{
  "info": {
    "name": "Bounty Hunting API",
    "description": "Run `python manage.py seed_data` before running this collection (resets ids to 1..6 / 1..12).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Criminals",
      "item": [
        {
          "name": "List all criminals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns array of >=5\", () => pm.expect(pm.response.json().length).to.be.at.least(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: min_reward=5000 & armed=true, sort=-reward (combined)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"All armed with reward >= 5000\", () => d.forEach(c => { pm.expect(c.armed).to.be.true; pm.expect(c.reward).to.be.at.least(5000); }));",
                  "pm.test(\"Sorted by reward desc\", () => { for (let i = 1; i < d.length; i++) pm.expect(d[i-1].reward).to.be.at.least(d[i].reward); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: reward range 1000-30000",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?min_reward=1000&max_reward=30000&sort=reward",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "1000"
                },
                {
                  "key": "max_reward",
                  "value": "30000"
                },
                {
                  "key": "sort",
                  "value": "reward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"In range\", () => pm.response.json().forEach(c => pm.expect(c.reward).to.be.within(1000, 30000)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: has_crew=true & escape_master=true",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?has_crew=true&escape_master=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "has_crew",
                  "value": "true"
                },
                {
                  "key": "escape_master",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Flags match\", () => pm.response.json().forEach(c => { pm.expect(c.has_crew).to.be.true; pm.expect(c.escape_master).to.be.true; }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sort by reward ascending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/?sort=reward",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "reward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"Ascending\", () => { for (let i = 1; i < d.length; i++) pm.expect(d[i-1].reward).to.be.at.most(d[i].reward); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Criminal details (id=1, includes hunts)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/criminals/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "criminals",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has hunts array\", () => pm.expect(pm.response.json().hunts).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Hunt logs (CRUD)",
      "item": [
        {
          "name": "List all hunt logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\">=10 logs\", () => pm.expect(pm.response.json().length).to.be.at.least(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "List hunt logs for criminal 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/?criminal_id=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts"
              ],
              "query": [
                {
                  "key": "criminal_id",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Only criminal 1\", () => pm.response.json().forEach(h => pm.expect(h.criminal_id).to.eql(1)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create hunt log (created_at from client is ignored)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const h = pm.response.json();",
                  "pm.collectionVariables.set(\"hunt_id\", h.id);",
                  "pm.test(\"Has server timestamp\", () => pm.expect(h.created_at).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the created hunt log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Correct id\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"hunt_id\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update success & notes (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"notes\": \"Recaptured after a second chase.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Updated\", () => { const h = pm.response.json(); pm.expect(h.success).to.be.true; pm.expect(h.notes).to.include(\"Recaptured\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete hunt log",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted hunt log (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Invalid requests",
      "item": [
